    "### Conditional Statements - If/Else"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5 is odd\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Enter your number:\"))\n",
    "if(n == 0):\n",
    "    print(\"The Number is zero\")\n",
    "elif(n == 1 or n== 2):\n",
    "    print(\"The number is neither odd nor even\")\n",
    "elif(n%2 == 0):\n",
    "    print(n,\"is even\")\n",
    "else:\n",
    "    print(n,\"is odd\")"
   ]
  }
